<?xml version="1.0" encoding="utf-8"?>
<!-- Just the two pill buttons; no card, no label. Transparent so the widget is the buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/widget_send"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_solid"
        android:gravity="center"
        android:text="@string/widget_send"
        android:textColor="#040404"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_receive"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_outline"
        android:gravity="center"
        android:text="@string/widget_receive"
        android:textColor="#F9F8F9"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
